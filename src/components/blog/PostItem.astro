---
import type { CollectionEntry } from "astro:content";
import Link from "@/components/nav/Link.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const href = `/blog/${post.id}/`;
const dateStr = post.data.date.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<div class="py-4">
  <div class="flex items-baseline gap-4 flex-wrap">
    <time
      class="text-xs font-mono text-gray-600 dark:text-gray-400 shrink-0 w-28"
    >
      {dateStr}
    </time>
    <div class="min-w-0">
      <Link href={href}>{post.data.title}</Link>
      <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5">
        {post.data.description}
      </p>
    </div>
  </div>
</div>
