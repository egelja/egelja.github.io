---
import { Icon } from "astro-icon/components";

import { cva } from "cva";
import { twMerge } from "tailwind-merge";

interface Props {
  // URL
  href: string;

  // Styling
  class?: any;
  noUnderline?: boolean;
  noColor?: boolean;

  // Astro
  children: any;
}

// Get props
const {
  href,
  class: className,
  noUnderline = false,
  noColor = false,
} = Astro.props;

// Check if outgoing URL
const url = new URL(href, Astro.site);
const outgoing = url.host != Astro.site!.host;

// Active state
const isActive = !outgoing && Astro.url.pathname === href;

// Add attributes to outgoing URLs
const target = outgoing ? "_blank" : "_self"; // _self is default
const rel = outgoing ? "noopener noreferrer" : undefined;

// Style attributes
const linkVariants = cva(["inline", "py-0.25"], {
  variants: {
    color: { false: null, true: ["text-accent"] },
    outgoing: { false: ["px-0.5"], true: null },
  },
});

const linkClasses = twMerge(
  linkVariants({ className, color: !noColor, outgoing }),
);
---

<a
  id="link"
  href={href}
  class={linkClasses}
  target={target}
  rel={rel}
  data-underline={!noUnderline}
  aria-current={isActive ? "page" : undefined}
>
  <!-- Comments to gobble whitespace while allowing proper auto formatting. -->
  <span id="link-text" class="inline">
    <slot />
  </span><!---
-->{
    outgoing && (
      <span class="inline-block align-middle -translate-y-0.5">
        <Icon name="flowbite:arrow-up-right-from-square-outline" />
      </span>
    )
  }<!--
--></a
>

<style>
  /*
  Source - https://stackoverflow.com/a/62872785
    Posted by Temani Afif, modified by community. See post 'Timeline' for change history
    Retrieved 2026-02-11, License - CC BY-SA 4.0
  */
  @media (hover: hover) {
    #link:hover {
      color: var(--color-accent);
    }
    #link[data-underline="true"] {
      --link-underline-color: var(--color-accent);
      background: linear-gradient(var(--link-underline-color) 0 0) bottom left/
        var(--underline-width, 0%) 0.1em no-repeat;
      transition: background-size 0.5s;
    }
    #link[data-underline="true"]:hover {
      --underline-width: 100%;
    }
  }
</style>
