---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section
  class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 py-10 md:py-16 border-t-2 border-blurple-600 dark:border-blurple-400 items-start"
>
  <div class="md:col-span-4 lg:col-span-3">
    <h2 class="font-serif font-bold text-2xl text-gray-900 dark:text-gray-100">
      {title}
    </h2>
  </div>
  <div class="md:col-span-8 lg:col-span-9">
    <slot />
  </div>
</section>
