---
import Link from "@/components/nav/Link.astro";

import { Icon } from "astro-icon/components";
import NavLinks from "./NavLinks.astro";

// props
interface Props {
  menuIconId: string;
}

const { menuIconId } = Astro.props;
---

<header class="fixed top-0 right-0 left-0 bg-white border-b border-b-gray-400">
  <nav class="mx-auto max-w-5xl flex items-center justify-between p-5 lg:px-7">
    <div class="flex-1 grow">
      <a href="/" class="text-l sm:text-xl font-serif">
        <strong class="font-bold text-cyan-600">Nikola V.</strong> Maruszewski
      </a>
    </div>
    <NavLinks style="header" class="flex-1"/>
    <div class="flex-1 sm:hidden flex justify-end grow-0">
      <Icon
        id={menuIconId}
        class="cursor-pointer"
        name="flowbite:bars-outline"
        size="1.5rem"
      />
    </div>
  </nav>
</header>
