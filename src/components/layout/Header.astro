---
import { Icon } from "astro-icon/components";
import Link from "@/components/nav/Link.astro";
import ThemeToggleButton from "./ThemeToggleButton.astro";
import { NAV_LINKS } from "@/constants";

interface Props {
  menuIconId: string;
  themeToggleId: string;
}

const { menuIconId, themeToggleId } = Astro.props;
---

<header class="fixed top-0 right-0 left-0 z-50 border-b border-b-gray-400 dark:border-b-gray-700 bg-blurple-50 dark:bg-blurple-900">
  <nav class="mx-auto max-w-5xl flex items-center justify-between p-5 lg:px-7">
    <div class="flex-1 grow">
      <a href="/" class="text-xl sm:text-1.5xl font-serif">
        <strong class="font-bold text-accent">Nikola V.</strong> Maruszewski
      </a>
    </div>
    <div class="hidden sm:flex items-center justify-end gap-2 md:gap-3 mr-2 md:mr-3">
      {NAV_LINKS.map(({ href, label }) => (
        <Link class="grow-0" noColor href={href}>{label}</Link>
      ))}
    </div>
    <div class="flex items-center gap-2">
      <ThemeToggleButton id={themeToggleId} />
      <Icon
        id={menuIconId}
        class="sm:hidden cursor-pointer"
        name="flowbite:bars-outline"
        size="1.5rem"
      />
    </div>
  </nav>
</header>

