---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const href = `/projects/${project.id}/`;
---

<!-- TODO: this doesn't animate sometimes either. fix. -->
<a
  href={href}
  class="group block rounded-xl overflow-hidden border-2 border-blurple-600 dark:border-blurple-100 hover:border-blurple-800 dark:hover:border-blurple-300 transition-all duration-200 hover:shadow-lg hover:shadow-blurple-900/20 bg-white dark:bg-blurple-950"
>
  {
    project.data.image ? (
      <Image
        src={project.data.image}
        alt={project.data.title}
        class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-300"
      />
    ) : (
      <div class="w-full aspect-video bg-blurple-950 dark:bg-blurple-900 flex flex-col items-center justify-center gap-2">
        <span class="text-5xl select-none">🚧</span>
        <span class="text-blurple-400 text-xs font-mono tracking-widest uppercase">
          under construction
        </span>
      </div>
    )
  }
  <div class="p-4">
    <!-- TODO: this doesn't animate. fix. -->
    <h2
      class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-accent transition-all duration-200"
    >
      {project.data.title}
    </h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">
      {project.data.description}
    </p>
    {
      project.data.tags && project.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-3">
          {project.data.tags.map((tag) => (
            <span class="px-2 py-0.5 text-xs rounded bg-blurple-100 dark:bg-blurple-900 text-blurple-700 dark:text-blurple-300">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</a>
