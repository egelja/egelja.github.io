---
import Link from "@/components/nav/Link.astro";

interface Props {
  label: string;
  href: string;
  value: string;
}

const { label, href, value } = Astro.props;
---

<div class="flex flex-col gap-2">
  <span
    class="text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400"
  >
    {label}
  </span>
  <div class="grow-0">
  <Link href={href} class="grow-0 font-medium text-gray-900 dark:text-gray-100">
    {value}
  </Link>
</div>
