---
import Link from "@/components/nav/Link.astro";

interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
  pageBasePath: string;
}

const { currentPage, totalPages, basePath, pageBasePath } = Astro.props;

const getPageHref = (page: number) =>
  page === 1 ? `${basePath}/` : `${pageBasePath}/${page}/`;
---

{
  totalPages > 1 && (
    <nav
      class="flex items-center justify-center gap-3 mt-12"
      aria-label="Pagination"
    >
      {currentPage > 1 ? (
        <Link href={getPageHref(currentPage - 1)} noColor>
          ← Prev
        </Link>
      ) : (
        <span class="text-gray-300 dark:text-gray-600 select-none">
          ← Prev
        </span>
      )}

      <div class="flex items-center gap-1">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) =>
          page === currentPage ? (
            <span class="px-3 py-1 rounded text-sm font-bold bg-blurple-600 dark:bg-blurple-400 text-white dark:text-gray-900">
              {page}
            </span>
          ) : (
            <Link href={getPageHref(page)} noColor noUnderline>
              <span class="px-3 py-1 rounded text-sm hover:bg-blurple-100 dark:hover:bg-blurple-900 transition-colors">
                {page}
              </span>
            </Link>
          ),
        )}
      </div>

      {currentPage < totalPages ? (
        <Link href={getPageHref(currentPage + 1)} noColor>
          Next →
        </Link>
      ) : (
        <span class="text-gray-300 dark:text-gray-600 select-none">
          Next →
        </span>
      )}
    </nav>
  )
}
