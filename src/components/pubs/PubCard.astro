---
import { Picture } from "astro:assets";

import acmAvailable from "@/images/badges/acm-available.png";
import acmFunctional from "@/images/badges/acm-functional.png";
import acmReusable from "@/images/badges/acm-reusable.png";
import acmReproduced from "@/images/badges/acm-reproduced.png";
import acmReplicated from "@/images/badges/acm-replicated.png";

type BadgeKey =
  | "acm-available"
  | "acm-functional"
  | "acm-reusable"
  | "acm-reproduced"
  | "acm-replicated";

const BADGE_IMAGES: Record<BadgeKey, ImageMetadata> = {
  "acm-available": acmAvailable,
  "acm-functional": acmFunctional,
  "acm-reusable": acmReusable,
  "acm-reproduced": acmReproduced,
  "acm-replicated": acmReplicated,
};

const BADGE_LABELS: Record<BadgeKey, string> = {
  "acm-available": "ACM Artifacts Available",
  "acm-functional": "ACM Artifacts Evaluated – Functional",
  "acm-reusable": "ACM Artifacts Evaluated – Reusable",
  "acm-reproduced": "ACM Results Reproduced",
  "acm-replicated": "ACM Results Replicated",
};

const MY_NAME = "Nikola Vuk Maruszewski";

interface Props {
  title: string;
  authors: string[];
  venue: string;
  date: Date;
  pdf?: string;
  badges?: BadgeKey[];
  arxiv?: string;
  doi?: string;
  equalContributorIndices?: number[];
}

const { title, authors, venue, date, pdf, badges, arxiv, doi, equalContributorIndices } = Astro.props;

const dateStr = date.toLocaleDateString("en-US", {
  month: "2-digit",
  year: "numeric",
  timeZone: "UTC",
}).replace("/", ".");
---

<article class="py-10 md:py-14 flex flex-col items-center gap-4 text-center">
  <h2 class="font-serif font-bold text-2xl md:text-3xl text-gray-900 dark:text-gray-100 leading-snug max-w-2xl">
    {title}
  </h2>

  <div class="flex flex-col items-center gap-2">
    <p class="text-sm text-gray-700 dark:text-gray-300 max-w-2xl leading-relaxed">
      {authors.map((author, i) => (
        <>
          {i > 0 && <span class="text-gray-400 dark:text-gray-500">,{" "}</span>}
          {author === MY_NAME ? (
            <em class="italic font-semibold text-accent">{author}{equalContributorIndices?.includes(i) ? "*" : ""}</em>
          ) : (
            <span>{author}{equalContributorIndices?.includes(i) ? "*" : ""}</span>
          )}
        </>
      ))}
    </p>
    {equalContributorIndices && equalContributorIndices.length > 0 && (
      <div>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 equal-contrib-note">
          (* denotes equal contribution)
        </p>
      </div>
    )}
  </div>

  <div class="flex flex-col items-center gap-0.5">
    <span class="text-sm text-gray-500 dark:text-gray-400">{venue}</span>
    <span class="text-sm font-mono text-gray-500 dark:text-gray-400">{dateStr}</span>
  </div>

  {badges && badges.length > 0 && (
    <div class="flex flex-wrap justify-center gap-3 mt-1">
      {badges.map((badge) => (
        <Picture
          src={BADGE_IMAGES[badge]}
          formats={["avif", "webp", "jpg"]}
          alt={BADGE_LABELS[badge]}
          height={64}
          class="h-16 w-auto"
        />
      ))}
    </div>
  )}

  <div class="flex flex-wrap justify-center gap-3 mt-2">
    {pdf && (
      <a
        href={`/papers/${pdf}`}
        download
        class="inline-flex items-center gap-2 px-4 py-2 rounded bg-blurple-700 dark:bg-blurple-300 text-gray-100 dark:text-gray-900 text-sm font-semibold hover:bg-blurple-600 dark:hover:bg-blurple-400 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0">
          <path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z" />
          <path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z" />
        </svg>
        Download PDF
      </a>
    )}
    {arxiv && (
      <a
        href={`https://arxiv.org/abs/${arxiv}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded border-2 border-blurple-600 dark:border-blurple-400 text-blurple-600 dark:text-blurple-300 text-sm font-semibold hover:bg-blurple-100 dark:hover:bg-blurple-800 transition-colors"
      >
        arXiv
      </a>
    )}
    {doi && (
      <a
        href={`https://doi.org/${doi}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded border-2 border-blurple-600 dark:border-blurple-400 text-blurple-600 dark:text-blurple-300 text-sm font-semibold hover:bg-blurple-100 dark:hover:bg-blurple-800 transition-colors"
      >
        DOI
      </a>
    )}
  </div>
</article>