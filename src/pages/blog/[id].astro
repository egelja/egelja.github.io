---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/nav/Link.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({ params: { id: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const hasBody = post.body && post.body.trim().length > 0;

const dateStr = post.data.date.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title={`${post.data.title} | Blog`}
  description={post.data.description}
>
  <div>
    <Link href="/blog/" noColor>← Blog</Link>
  </div>

  <div class="mt-6 mb-2">
    <span class="text-xs uppercase tracking-widest text-gray-400"
      >{dateStr}</span
    >
  </div>

  <h1
    class="font-serif font-extrabold text-3xl leading-tight text-gray-900 dark:text-gray-100 mb-4"
  >
    {post.data.title}
  </h1>

  {
    hasBody ? (
      <div class="prose dark:prose-invert max-w-none mt-6 text-gray-700 dark:text-gray-300">
        <Content components={{ a: Link }} />
      </div>
    ) : (
      <div class="flex flex-col items-center justify-center py-24 gap-4">
        <span class="text-6xl select-none">🚧</span>
        <p class="text-2xl font-semibold text-gray-700 dark:text-gray-300">
          Coming Soon
        </p>
        <p class="text-gray-500 dark:text-gray-400 text-sm">Check back later.</p>
      </div>
    )
  }
</BaseLayout>
