---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/nav/Link.astro";
---

<BaseLayout title="404 — Not Found">
  <div class="flex flex-col items-center justify-center text-center py-32 gap-6">
    <span class="font-serif font-extrabold text-accent leading-none" style="font-size: clamp(6rem, 30vw, 14rem);">
      404
    </span>
    <p class="text-xl text-gray-600 dark:text-gray-400">
      This page doesn't exist.
    </p>
    <Link href="/">Go home</Link>
  </div>
</BaseLayout>
