---
import EmptyLayout from "@/layouts/EmptyLayout.astro";
import HeroName from "@/components/landing/HeroName.astro";
import LandingNav from "@/components/landing/LandingNav.astro";
import Footer from "@/components/layout/Footer.astro";
import ThemeToggleButton from "@/components/layout/ThemeToggleButton.astro";
---

<EmptyLayout>
  <div
    class="relative bg-blurple-50 dark:bg-blurple-900 text-gray-900 dark:text-gray-100 min-h-screen flex flex-col"
  >
    <div class="absolute top-0 right-0 p-5 z-10">
      <ThemeToggleButton id="theme-toggle-landing" />
    </div>
    <main
      id="main-content"
      class="grow flex flex-col items-center justify-center text-center px-6 gap-10"
    >
      <HeroName />
      <p
        class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-xl leading-relaxed"
      >
        PhD Student &amp; Researcher, working at the intersection of computer
        systems and low-power embedded computing.
      </p>
      <LandingNav />
    </main>
    <Footer />
  </div>

  <script>
    function setupLandingPage() {
      const toggle = document.getElementById("theme-toggle-landing");
      if (toggle) {
        toggle.setAttribute(
          "aria-pressed",
          String(document.documentElement.classList.contains("dark")),
        );
        toggle.addEventListener("click", () => {
          const nowDark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", nowDark ? "dark" : "light");
          toggle.setAttribute("aria-pressed", String(nowDark));
          toggle.classList.add("spinning");
          toggle.addEventListener(
            "animationend",
            () => toggle.classList.remove("spinning"),
            { once: true },
          );
        });
      }
    }

    setupLandingPage();
    document.addEventListener("astro:after-swap", setupLandingPage);
  </script>
</EmptyLayout>
