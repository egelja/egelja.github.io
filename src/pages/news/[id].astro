---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/nav/Link.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const items = await getCollection("news");
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(item);
const hasBody = item.body && item.body.trim().length > 0;

const dateStr = item.data.date.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const badgeLabel: Record<typeof item.data.type, string> = {
  paper: "Paper",
  talk: "Talk",
  award: "Award",
  position: "Position",
};
---

<BaseLayout title={item.data.title}>
  <div>
    <Link href="/about/" noColor>← About</Link>
  </div>

  <div class="mt-6 mb-2 flex items-center gap-3 flex-wrap">
    <span class="px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wide bg-blurple-700 dark:bg-blurple-300 text-gray-100 dark:text-gray-900">
      {badgeLabel[item.data.type]}
    </span>
    <span class="text-xs uppercase tracking-widest text-gray-400">{dateStr}</span>
  </div>

  <h1 class="font-serif font-extrabold text-3xl leading-tight text-gray-900 dark:text-gray-100 mb-2">
    {item.data.title}
  </h1>

  {item.data.details && item.data.details.length > 0 && (
    <p class="text-gray-500 dark:text-gray-400 mb-6">{item.data.details.join(" · ")}</p>
  )}

  {hasBody && (
    <div class="news-body mt-6 border-t border-gray-200 dark:border-gray-800 pt-6 text-gray-700 dark:text-gray-300 leading-relaxed space-y-4">
      <Content components={{ a: Link }} />
    </div>
  )}
</BaseLayout>

<style>
  .news-body :global(strong) {
    font-weight: 700;
    color: inherit;
  }
  .news-body :global(p) {
    margin-bottom: 1rem;
  }
  .news-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
