---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectTile from "@/components/projects/ProjectTile.astro";
import Pagination from "@/components/shared/Pagination.astro";

const ITEMS_PER_PAGE = 6;

const allProjects = (await getCollection("projects"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const totalPages = Math.ceil(allProjects.length / ITEMS_PER_PAGE);
const projects = allProjects.slice(0, ITEMS_PER_PAGE);
---

<BaseLayout title="Projects">
  <section>
    <h1
      class="font-serif font-extrabold text-4xl leading-tight mb-2 text-gray-900 dark:text-gray-100"
    >
      Projects
    </h1>
  </section>

  <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map((project) => <ProjectTile project={project} />)}
  </div>

  <Pagination
    currentPage={1}
    totalPages={totalPages}
    basePath="/projects"
    pageBasePath="/projects/page"
  />
</BaseLayout>
