---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/nav/Link.astro";
import PdfViewer from "@/components/shared/PdfViewer.tsx";
---

<BaseLayout title="CV">
  <div class="flex items-center justify-between mb-6">
    <h1
      class="font-serif font-extrabold text-4xl leading-tight text-gray-900 dark:text-gray-100"
    >
      CV
    </h1>
    <a
      href="/cv-Nikola_Maruszewski.pdf"
      download
      class="text-xs font-bold uppercase tracking-widest text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-100 transition-colors"
    >
      Download
    </a>
  </div>

  <PdfViewer
    client:only="preact"
    src="/cv-Nikola_Maruszewski.pdf"
    title="Nikola V. Maruszewski — CV"
  >
    PDF viewer not loading? <Link href="/cv-Nikola_Maruszewski.pdf"
      >Download CV directly.</Link
    ><!-- 
--></PdfViewer
  >
</BaseLayout>
