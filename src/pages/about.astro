---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Link from "@/components/nav/Link.astro";
import SectionWrapper from "@/components/about/SectionWrapper.astro";
import NewsItem from "@/components/about/NewsItem.astro";
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import profPic from "@/images/prof_pic.jpg";

const NEWS_DEFAULT_COUNT = 5;

const newsItems = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const hasMore = newsItems.length > NEWS_DEFAULT_COUNT;
---

<BaseLayout title="About">
  <!-- Hero -->
  <section
    class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-10 md:pb-16 items-start"
  >
    <div class="md:col-span-8">
      <h1
        class="font-serif font-extrabold text-4xl leading-tight mb-8 text-gray-900 dark:text-gray-100"
      >
        About Me
      </h1>
      <div
        class="max-w-2xl space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed"
      >
        <p id="bio-text">
          Nikola Vuk Maruszewski is a PhD student in Computer Science at
          <Link href="https://gatech.edu">Georgia Tech</Link>, advised by
          <Link href="https://josiahhester.com">Prof. Josiah Hester</Link>
          in the <Link href="https://kamoamoa.com">Ka Moamoa Lab</Link>. He
          works on embedded systems for resource-constrained and batteryless
          devices. Nikola holds a BS in Computer Science and MS in Computer
          Engineering from
          <Link href="https://northwestern.edu">Northwestern University</Link>,
          where he worked with
          <Link href="https://users.cs.northwestern.edu/~hardav/"
            >Prof. Nikos Hardavellas</Link
          >
          in the
          <Link href="https://paragon.cs.northwestern.edu/">PARAG@N Lab</Link>.
          His work there spanned prefetching for linked data structures and
          compilation techniques for quantum chiplet architectures. He graduated
          <em>summa cum laude</em>, was named an Outstanding CS Senior, and is a member
          of Tau Beta Pi.
        </p>
      </div>
      <button
        id="copy-bio-btn"
        class="mt-4 text-xs font-bold uppercase tracking-widest text-gray-500 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-100 transition-colors cursor-pointer"
      >
        Copy bio
      </button>
      <span
        id="copy-bio-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        class="sr-only"
      ></span>
    </div>
    <div class="md:col-span-4">
      <div class="aspect-4/5 overflow-hidden rounded-lg">
        <Picture
          src={profPic}
          formats={["avif", "webp", "png"]}
          alt="Nikola V. Maruszewski"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Research Interests -->
  <SectionWrapper title="Research Interests">
    <div
      class="max-w-2xl space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed"
    >
      <p>
        My research focuses on applying systems techniques to improve
        performance and enable complex applications on constrained hardware,
        drawing on computer architecture, compilers, and operating systems. I'm
        interested in work that ships to real, deployed devices.
      </p>
      <p>
        My current work spans two projects: timekeeping for batteryless embedded
        devices under intermittent power, and enabling low-power Edge-AI with
        multimodal models using heterogeneous compute.
      </p>
    </div>
  </SectionWrapper>

  <!-- News -->
  <section
    class="py-10 md:py-16 border-t-2 border-blurple-600 dark:border-blurple-400"
  >
    <h2
      class="font-serif font-bold text-2xl text-gray-900 dark:text-gray-100 mb-8"
    >
      News and Announcements
    </h2>
    <div id="news-list" class="space-y-5">
      {
        newsItems.map((item, i) => (
          <div
            class:list={[i >= NEWS_DEFAULT_COUNT && "hidden"]}
            data-news-item
          >
            <NewsItem
              title={item.data.title}
              date={item.data.date}
              type={item.data.type}
              details={item.data.details}
              slug={item.id}
            />
          </div>
        ))
      }
    </div>
    {
      hasMore && (
        <button
          id="news-more-btn"
          aria-expanded="false"
          aria-controls="news-list"
          class="mt-6 text-xs uppercase tracking-widest text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors cursor-pointer"
        >
          Show more
        </button>
      )
    }
  </section>

  <script>
    function setupAboutPage() {
      document
        .getElementById("copy-bio-btn")
        ?.addEventListener("click", async (e) => {
          const btn = e.currentTarget as HTMLButtonElement;
          const bio = document.getElementById("bio-text");
          const clone = bio?.cloneNode(true) as HTMLElement | undefined;
          clone?.querySelectorAll("svg").forEach((el) => el.remove());
          const text =
            clone?.textContent
              ?.replace(/\s+/g, " ")
              .replace(/\s+([,.;:!?])/g, "$1")
              .trim() ?? "";

          let success = false;
          if (navigator.clipboard?.writeText) {
            try {
              await navigator.clipboard.writeText(text);
              success = true;
            } catch {}
          }
          if (!success) {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.style.cssText =
              "position:fixed;left:0;top:0;opacity:0;pointer-events:none";
            document.body.appendChild(ta);
            ta.focus();
            ta.setSelectionRange(0, ta.value.length);
            try {
              success = document.execCommand("copy");
            } finally {
              document.body.removeChild(ta);
            }
          }

          if (success) {
            btn.textContent = "Copied!";
            const status = document.getElementById("copy-bio-status");
            if (status) status.textContent = "Bio copied to clipboard.";
            setTimeout(() => {
              btn.textContent = "Copy bio";
              if (status) status.textContent = "";
            }, 2000);
          }
        });

      document
        .getElementById("news-more-btn")
        ?.addEventListener("click", (e) => {
          const btn = e.currentTarget as HTMLButtonElement;
          const hidden = document.querySelectorAll("[data-news-item].hidden");
          Array.from(hidden)
            .slice(0, 5)
            .forEach((el) => el.classList.remove("hidden"));
          if (
            document.querySelectorAll("[data-news-item].hidden").length === 0
          ) {
            btn.setAttribute("aria-expanded", "true");
            btn.remove();
          }
        });
    }

    document.addEventListener("astro:after-swap", setupAboutPage);
    setupAboutPage();
  </script>
</BaseLayout>
