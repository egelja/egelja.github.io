---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactItem from "@/components/contact/ContactItem.astro";
---

<BaseLayout title="Contact">
  <h1
    class="font-serif font-extrabold text-4xl leading-tight text-gray-900 dark:text-gray-100 mb-8"
  >
    Contact
  </h1>

  <div class="space-y-8 md:space-y-10">
    <ContactItem
      label="Email"
      href="mailto:nikola@marusz.com"
      value="nikola@marusz.com"
    />
    <ContactItem label="Phone" href="tel:+18476443542" value="(847) 644-3542" />
    <ContactItem
      label="GitHub"
      href="https://github.com/egelja"
      value="egelja"
    />
    <ContactItem
      label="LinkedIn"
      href="https://www.linkedin.com/in/nikola-maruszewski"
      value="nikola-maruszewski"
    />
    <ContactItem
      label="ORCID"
      href="https://orcid.org/0009-0009-5468-4085"
      value="0009-0009-5468-4085"
    />
    <ContactItem
      label="Google Scholar"
      href="https://scholar.google.com/citations?user=ye4YtpsAAAAJ"
      value="Nikola V. Maruszewski"
    />
    <ContactItem
      label="Mastodon"
      href="https://discuss.systems/@nikola"
      value="@nikola"
    />
  </div>

  <div class="mt-12 pt-8 border-t-2 border-blurple-600 dark:border-blurple-400">
    <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
      Email is the best way to reach me. Feel free to get in touch for research
      inquiries, collaboration opportunities, or just to chat about systems and
      embedded computing.
    </p>
  </div>
</BaseLayout>
