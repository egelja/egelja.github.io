---
import EmptyLayout from "@/layouts/EmptyLayout.astro";
import Header from "@/components/layout/Header.astro";

// Component args
interface Props {
  title?: string | null;
  description?: string | null;
  children: any;
}

// Get props
const { title = null, description = null } = Astro.props;
---

<EmptyLayout title={title} description={description}>
  <Header />
  <slot />
</EmptyLayout>
