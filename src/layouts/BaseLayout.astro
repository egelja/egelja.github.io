---
import EmptyLayout from "@/layouts/EmptyLayout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import Link from "@/components/nav/Link.astro";
import { Icon } from "astro-icon/components";
import { NAV_LINKS } from "@/constants";

// Component args
interface Props {
  title?: string | null;
  description?: string | null;
  children: any;
}

// Get props
const { title = null, description = null } = Astro.props;
---

<EmptyLayout title={title} description={description}>
  <div
    id="content"
    class="bg-blurple-50 dark:bg-blurple-900 text-gray-900 dark:text-gray-100 w-full min-h-screen flex flex-col relative z-10"
    transition:animate="fade"
  >
    <Header menuIconId="menu-icon" themeToggleId="theme-toggle" />
    <main id="main-content" class="mx-auto max-w-4xl pt-18 sm:pt-20 px-6 pb-24 grow w-full">
      <div class="pt-12 w-full flex flex-col items-stretch">
        <slot />
      </div>
    </main>
    <Footer />
  </div>
  <aside
    id="sidebar"
    class="w-full fixed inset-0 z-0 bg-blurple-900 dark:bg-blurple-600 text-white"
    aria-label="Navigation menu"
    aria-hidden="true"
    aria-modal="true"
  >
    <div class="flex flex-col">
      <div class="flex-1 flex justify-end grow-0 p-5 pb-0">
        <button
          id="sidebar-close-btn"
          class="cursor-pointer flex items-center justify-center"
          aria-label="Close navigation menu"
        >
          <Icon name="flowbite:close-outline" size="1.5rem" aria-hidden="true" />
        </button>
      </div>
      <div class="flex-1 flex flex-col p-4 text-1.5xl">
        <Link class="m-5" noColor noUnderline href="/">home</Link>
        {
          NAV_LINKS.map(({ href, label }) => (
            <Link class="m-5" noColor noUnderline href={href}>
              {label}
            </Link>
          ))
        }
      </div>
    </div>
  </aside>

  <style is:global>
    #content {
      transition:
        transform 0.25s ease-in-out,
        background-color 0.3s ease,
        border-color 0.3s ease;
    }
    .sidebar--open #content {
      transform: translate3d(-100%, 0, 0);
    }
    #sidebar {
      visibility: hidden;
      /* delay hiding until content has slid back into place */
      transition: visibility 0s 0.25s;
    }
    .sidebar--open #sidebar {
      visibility: visible;
      transition-delay: 0s;
    }
    /* lock body scroll while sidebar is open */
    html:has(.sidebar--open),
    .sidebar--open {
      overflow: hidden;
    }
  </style>

  <script>
    function setupScripts() {
      const sidebar = document.getElementById("sidebar");
      const menuBtn = document.getElementById("menu-icon");
      const closeBtn = document.getElementById("sidebar-close-btn");
      const body = document.getElementById("body");

      const FOCUSABLE =
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
      const getFocusable = () =>
        Array.from(
          sidebar?.querySelectorAll(FOCUSABLE) ?? [],
        ) as HTMLElement[];

      function trapFocus(e: KeyboardEvent) {
        if (e.key !== "Tab") return;
        const els = getFocusable();
        if (!els.length) return;
        const atFirst = document.activeElement === els[0];
        const atLast = document.activeElement === els[els.length - 1];
        if (e.shiftKey ? atFirst : atLast) {
          e.preventDefault();
          (e.shiftKey ? els[els.length - 1] : els[0]).focus();
        }
      }

      function handleEscape(e: KeyboardEvent) {
        if (e.key === "Escape") closeSidebar();
      }

      function openSidebar() {
        body?.classList.add("sidebar--open");
        sidebar?.setAttribute("aria-hidden", "false");
        menuBtn?.setAttribute("aria-expanded", "true");
        closeBtn?.focus();
        document.addEventListener("keydown", trapFocus);
        document.addEventListener("keydown", handleEscape);
      }

      function closeSidebar() {
        body?.classList.remove("sidebar--open");
        sidebar?.setAttribute("aria-hidden", "true");
        menuBtn?.setAttribute("aria-expanded", "false");
        document.removeEventListener("keydown", trapFocus);
        document.removeEventListener("keydown", handleEscape);
        menuBtn?.focus();
      }

      closeBtn?.addEventListener("click", closeSidebar);
      menuBtn?.addEventListener("click", openSidebar);

      const themeToggle = document.getElementById("theme-toggle");
      if (themeToggle) {
        themeToggle.setAttribute(
          "aria-pressed",
          String(document.documentElement.classList.contains("dark")),
        );
        themeToggle.addEventListener("click", () => {
          const nowDark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", nowDark ? "dark" : "light");
          themeToggle.setAttribute("aria-pressed", String(nowDark));
          themeToggle.classList.add("spinning");
          themeToggle.addEventListener(
            "animationend",
            () => themeToggle.classList.remove("spinning"),
            { once: true },
          );
        });
      }
    }

    document.addEventListener("astro:after-swap", setupScripts);
    setupScripts();
  </script>
</EmptyLayout>
