---
import EmptyLayout from "@/layouts/EmptyLayout.astro";
import Header from "@/components/layout/Header.astro";
import NavLinks from "@/components/layout/NavLinks.astro";
import { Icon } from "astro-icon/components";

// Component args
interface Props {
  title?: string | null;
  description?: string | null;
  children: any;
}

// Get props
const { title = null, description = null } = Astro.props;
---

<EmptyLayout title={title} description={description}>
  <div
    id="content"
    class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100 w-full min-h-screen relative z-10"
  >
    <Header menuIconId="menu-icon" themeToggleId="theme-toggle" />
    <main class="mx-auto max-w-3xl pt-18 sm:pt-20">
      <slot />
    </main>
  </div>
  <aside
    id="sidebar"
    class="w-full absolute top-0 bottom-0 left-0 right-0 z-0 bg-gray-800 dark:bg-gray-950 text-white"
  >
    <div class="flex flex-col">
      <div class="flex-1 flex justify-end grow-0 p-5 pb-0">
        <Icon
          id="sidebar-close-icon"
          class="cursor-pointer"
          name="flowbite:close-outline"
          size="1.5rem"
        />
      </div>
      <NavLinks style="sidebar" class="flex-1" />
    </div>
  </aside>
</EmptyLayout>

<style is:global>
  /* Suppress all transitions during page load to prevent flash */
  html.no-transitions *,
  html.no-transitions *::before,
  html.no-transitions *::after {
    transition: none !important;
  }

  /* Smooth color transitions for dark mode */
  *,
  *::before,
  *::after {
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  #content {
    transition:
      transform 0.25s ease-in-out,
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .sidebar--open #content {
    transform: translate3d(-100%, 0, 0);
  }
  #sidebar {
    visibility: hidden;
  }
  .sidebar--open #sidebar {
    visibility: visible;
  }
</style>

<script>
  document.getElementById("sidebar")?.addEventListener("click", () => {
    document.getElementById("body")?.classList.remove("sidebar--open");
  });

  document.getElementById("menu-icon")?.addEventListener("click", () => {
    document.getElementById("body")?.classList.add("sidebar--open");
  });

  const themeToggle = document.getElementById("theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    themeToggle.classList.add("spinning");
    themeToggle.addEventListener("animationend", () => themeToggle.classList.remove("spinning"), { once: true });
  });
</script>
