---
import "@/styles/global.css";

import Head from "@/components/layout/Head.astro";
import Header from "@/components/layout/Header.astro";
import { ClientRouter } from "astro:transitions";

import { DEFAULT_TITLE, DEFAULT_DESCRIPTION } from "@/constants.ts";

// Component args
interface Props {
  title?: string | null;
  description?: string | null;
  children: any;
}

// Get props
const { title = null, description = null } = Astro.props;

// Build full title and description
const fullTitle = title == null ? DEFAULT_TITLE : `${title} | ${DEFAULT_TITLE}`;
const fullDescription = description == null ? DEFAULT_DESCRIPTION : description;
---

<html lang="en">
  <head>
    <!-- Boilerplate meta tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preconnect to font origins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />

    <!-- Font stylesheets -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,100..900;1,100..900&family=Quicksand:wght@300..700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/mshaugh/nerdfont-webfonts@v3.3.0/build/iosevka.css" />

    <!-- Dynamic meta tags -->
    <Head title={fullTitle} description={fullDescription} />

    <!-- View transitions router (disabled in dev for easier debugging) -->
    {!import.meta.env.DEV && <ClientRouter />}

    <!-- Web analytics -->
    <!-- TODO -->

    <!-- Dark mode switch. -->
    <script>
      const updateDarkMode = () => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }

        // Re-enable transitions once page has safely loaded
        requestAnimationFrame(() =>
          requestAnimationFrame(() =>
            document.documentElement.classList.remove("no-transitions"),
          ),
        );
      };

      // Block transitions during initial paint to prevent flash
      document.documentElement.classList.add("no-transitions");

      // Set dark mode
      updateDarkMode();

      // Suppress color transitions during view transition swap to prevent flicker
      document.addEventListener("astro:before-swap", () =>
        document.documentElement.classList.add("no-transitions"),
      );

      // Ensure dark mode is set after navigation
      document.addEventListener("astro:after-swap", updateDarkMode);
    </script>
  </head>
  <body id="body">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:rounded focus:bg-blurple-700 focus:text-white focus:font-bold"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
